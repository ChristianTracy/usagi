# Copy this file to `.env` and fill in your values. `.env` is gitignored, so
# secrets never end up in the repo. Real process environment variables win over
# this file, and both win over config.json.
#
# `config.json` holds the non-secret behaviour/tuning (temperature, tui, colors,
# limits); the values below are the machine-specific ones.

# --- required ---
BASE_URL=http://localhost:8080/v1
API_KEY=none

# MODEL is optional: when empty, usagi picks one from GET {BASE_URL}/models
# (the loaded model on a llama.cpp router, else the first advertised) and shows
# a note. Change it at runtime with /model.
MODEL=

# --- optional (uncomment to override config.json) ---
# SYSTEM=You are a coding assistant.
# REASONING=true
# CONTEXT_LENGTH=0
# --- sampling (all default to "omit" = the server/preset decides; override
#     here, in config.json, or at runtime with /samplings) ---
# TEMPERATURE=-1
# TOP_P=1
# MAX_TOKENS=0
# TOP_K=0
# MIN_P=-1
# REPEAT_PENALTY=0
# FREQUENCY_PENALTY=0
# PRESENCE_PENALTY=0
# SEED=-1
# STREAM_OPTIONS=true
# REASONING_EFFORT=
# THINKING_BUDGET=0
# READ_TIMEOUT=300
# SINGLE_TOOL_CALL=true
# MAX_TOOL_OUTPUT=6000
# TOOL_TIMEOUT=120
# WORKSPACE=
# SERVER=auto
# MODELS_CACHE_TTL=300
# TOOL_CHOICE=
# PARALLEL_TOOL_CALLS=false
# TUI_ANIMATION=full
# TUI_PET=pixel

# --- saved sessions (default: ~/.usagi/sessions) ---
# USAGI_SESSIONS_DIR=
# USAGI_AUTOSAVE=true
# USAGI_RESTORE_WORKSPACE=true
# USAGI_SESSIONS_MAX=50
# USAGI_SESSIONS_MAX_AGE_DAYS=0
